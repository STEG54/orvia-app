# amaya-photos-v1 : les photos passent par photo.php (connexion vérifiée) ; aucun script ne peut s'exécuter ici
Options -Indexes
<FilesMatch "\.(php|phtml|php\d|phar|pl|py|cgi|sh)$">
  Require all denied
</FilesMatch>
<FilesMatch "^[a-f0-9]{32}(_t)?\.jpg$">
  Require all denied
</FilesMatch>
RemoveHandler .php .phtml .php5 .php7 .php8
